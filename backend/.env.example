# Captain Culinary Kids — Backend environment variables
#
# Copy this file to `backend/.env` and fill in real values.
# Do NOT commit the populated `.env` (it is already in .gitignore).

# MongoDB connection string used by motor / pymongo.
# Examples:
#   mongodb://localhost:27017
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Logical database name inside the Mongo cluster.
DB_NAME=captain_culinary_kids

# Comma-separated list of origins allowed by CORS.
# Use "*" for local development; restrict in production.
CORS_ORIGINS=*
