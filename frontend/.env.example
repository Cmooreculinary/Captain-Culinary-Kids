# Captain Culinary Kids — Frontend environment variables (Create React App)
#
# Copy this file to `frontend/.env` and adjust values for your environment.
# CRA only exposes variables that start with REACT_APP_ to the browser bundle.

# Base URL of the FastAPI backend. The frontend appends `/api` itself.
# Examples:
#   http://localhost:8000
#   https://api.captainculinarykids.example.com
REACT_APP_BACKEND_URL=http://localhost:8000

# Opt-in webpack-dev-server health check endpoints (see frontend/plugins/health-check).
# Set to "true" to expose /health, /health/ready, /health/live, etc. in dev.
ENABLE_HEALTH_CHECK=false
